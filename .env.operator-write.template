# Guarded production write credential (strale_rw).
#
# DELIBERATELY NOT IN .env. An autonomous session reads .env; if this credential
# lived there, a session could open a writable connection directly with
# postgres() and every gate in lib/production-authority.ts would be decoration.
# Keeping it out of the ambient environment is what makes the answer to "can an
# ordinary session mutate production" actually be "no".
#
# Supply it for ONE command when a delegated write is genuinely needed, and
# clear it again afterwards by setting it back to $null:
#
#   $env:DATABASE_URL_WRITE = (Select-String -Path .env.operator-write `
#       -Pattern '^DATABASE_URL_WRITE=').Line.Substring(19)
#   npx tsx apps/api/scripts/reset-circuit-breaker.ts <slug>
#   $env:DATABASE_URL_WRITE = $null
#
# For a founder-gated action, a signed grant is required in addition:
#   $env:STRALE_FOUNDER_GRANT = 'v1.<id>.<purpose>.<expiry>.<sig>'
#
# strale_rw holds SELECT/INSERT/UPDATE/DELETE on schema public only. It does not
# own the tables, has no CREATE on the schema, and cannot perform DDL.
DATABASE_URL_WRITE=__REPLACED_AT_PROVISION_TIME__
