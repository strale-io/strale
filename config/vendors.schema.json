{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strale.dev/schemas/vendors.schema.json",
  "title": "Vendor state register (shadow mode)",
  "description": "M3 batch 3. Shadow register, not authoritative. See docs/strategy/2026-09-10-m3-vendor-state-model.md and config/vendors.yaml's own header comment. authority_active is always false until the founder-gated M4 cutover.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority_active", "non_vendor_sentinels", "vendors"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "authority_active": {
      "const": false,
      "description": "Always false in this batch and until the founder-gated M4 cutover. The Notion Vendor Roster stays the authority until then."
    },
    "non_vendor_sentinels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Provider strings on other surfaces that deliberately name no vendor (e.g. 'Other' in the coverage matrix, 'internal' in the env manifest). Each must currently appear on some surface as a provider value."
    },
    "vendors": {
      "type": "array",
      "items": { "$ref": "#/$defs/vendor" }
    }
  },
  "$defs": {
    "recordKeyOrUnknown": {
      "type": "string",
      "description": "A record key resolving to docs/decisions/records/<key>.md, or the literal string 'unknown'.",
      "pattern": "^(unknown|DEC-[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*(?:--notion-[0-9a-f]{32}|--git-[0-9a-f]{7,40})?)$"
    },
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "lifecycleEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "date", "decision", "reason"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["candidate", "evaluating", "active", "fallback", "held", "rejected", "deprecated", "retired", "unknown"]
        },
        "date": { "$ref": "#/$defs/isoDate" },
        "decision": { "$ref": "#/$defs/recordKeyOrUnknown" },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reevaluationTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "condition", "source"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["date", "price", "licensing", "outage", "other"]
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "date": { "$ref": "#/$defs/isoDate" },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "A repo path that states the trigger."
        }
      }
    },
    "verificationField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["verified", "unknown", "attestation-required"]
        },
        "verified_at": { "$ref": "#/$defs/isoDate" },
        "verified_by": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "description": "A repo path, never confidential content."
        },
        "outcome": {
          "type": "string",
          "enum": ["permitted", "conditional", "prohibited"],
          "description": "Present only when status is verified: what the recorded verification concluded. conditional means permitted only under a stated condition, given in note."
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "description": "Required when status is attestation-required (says the evidence is private) or when outcome is conditional (states the condition)."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "verified" } } },
          "then": { "required": ["status", "verified_at", "verified_by", "evidence", "outcome"] },
          "else": { "not": { "required": ["outcome"] } }
        },
        {
          "if": { "properties": { "outcome": { "const": "conditional" } }, "required": ["outcome"] },
          "then": { "required": ["note"] }
        },
        {
          "if": { "properties": { "status": { "const": "attestation-required" } } },
          "then": { "required": ["status", "note"] }
        }
      ]
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["unknown", "attestation-required", "authorized", "not-authorized"]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["authorized", "not-authorized"] } } },
          "then": { "required": ["status", "evidence"] }
        }
      ]
    },
    "vendor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "aliases", "lifecycle", "reevaluation_triggers", "verification", "authorization"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "lifecycle": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lifecycleEntry" }
        },
        "reevaluation_triggers": {
          "type": "array",
          "items": { "$ref": "#/$defs/reevaluationTrigger" }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["terms", "pricing", "licensing", "redistribution"],
          "properties": {
            "terms": { "$ref": "#/$defs/verificationField" },
            "pricing": { "$ref": "#/$defs/verificationField" },
            "licensing": { "$ref": "#/$defs/verificationField" },
            "redistribution": { "$ref": "#/$defs/verificationField" }
          }
        },
        "authorization": { "$ref": "#/$defs/authorization" }
      }
    }
  }
}
