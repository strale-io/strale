{
  "name": "straleio-langchain",
  "version": "0.1.1",
  "description": "LangChain tool for Strale: let a LangChain agent call pay-per-call tools with a Strale API key.",
  "homepage": "https://strale.io?src=npm-readme&utm_source=npm-readme&utm_medium=listing&utm_campaign=distribution-d0-d1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "tsx --test tests/*.test.ts"
  },
  "keywords": [
    "strale",
    "langchain",
    "ai",
    "agent",
    "tool",
    "capabilities"
  ],
  "license": "MIT",
  "engines": {
