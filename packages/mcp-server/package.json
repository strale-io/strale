{
  "name": "strale-mcp",
  "mcpName": "io.github.strale-io/strale",
  "version": "0.2.9",
  "description": "MCP server for Strale: one connection to hundreds of pay-per-call tools \u2014 company records, sanctions and PEP screening, email/phone/IBAN/VAT checks, web page reading, document extraction. Works with Claude, Cursor, VS Code and any MCP client.",
  "type": "module",
  "main": "./dist/server.js",
  "exports": {
    ".": "./dist/server.js",
    "./tools": "./dist/tools.js",
    "./entry-points": "./dist/entry-points.js"
  },
  "bin": {
    "strale-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/server.ts",
    "prepublishOnly": "npm run build",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.0",
    "zod": "^3.25.0"
  },
  "keywords": [
    "strale",
    "mcp",
    "ai",
    "agent",
    "tools",
    "capabilities",
    "model-context-protocol",
    "claude",
    "cursor",
    "windsurf",
    "paid-api",
    "x402",
    "agentic-payments"
  ],
  "author": "Strale <hello@strale.io> (https://strale.dev?src=npm-readme&utm_source=npm-readme&utm_medium=listing&utm_campaign=distribution-d0-d1)",
  "homepage": "https://strale.dev?src=npm-readme&utm_source=npm-readme&utm_medium=listing&utm_campaign=distribution-d0-d1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strale-io/strale.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/strale-io/strale/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.27.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
