{
	"name": "Strale: Monthly VAT Number Re-check",
	"nodes": [
		{
			"parameters": {
				"rule": {
					"interval": [
						{
							"field": "months",
							"triggerAtDayOfMonth": 1,
							"triggerAtHour": 7
						}
					]
				}
			},
			"id": "8b0c3c1e-0000-4000-8000-000000000011",
			"name": "First of the Month",
			"type": "n8n-nodes-base.scheduleTrigger",
			"typeVersion": 1.2,
			"position": [
				0,
				0
			]
		},
		{
			"parameters": {
				"documentId": {
					"__rl": true,
					"mode": "url",
					"value": ""
				},
				"sheetName": {
					"__rl": true,
					"mode": "name",
					"value": "Suppliers"
				},
				"options": {}
			},
			"id": "8b0c3c1e-0000-4000-8000-000000000012",
			"name": "Read Supplier List",
			"type": "n8n-nodes-base.googleSheets",
			"typeVersion": 4.5,
			"position": [
				240,
				0
			],
			"notes": "Point this at a sheet with a 'vat_number' column."
		},
		{
			"parameters": {
				"resource": "vatNumber",
				"operation": "check",
				"vatNumber": "={{ $json.vat_number }}"
			},
			"id": "8b0c3c1e-0000-4000-8000-000000000013",
			"name": "Strale",
			"type": "n8n-nodes-strale.strale",
			"typeVersion": 1,
			"position": [
				480,
				0
			],
			"credentials": {
				"straleApi": {
					"id": "",
					"name": "Strale account"
				}
			},
			"onError": "continueRegularOutput"
		},
		{
			"parameters": {
				"conditions": {
					"options": {
						"caseSensitive": true,
						"typeValidation": "strict"
					},
					"conditions": [
						{
							"leftValue": "={{ $json.valid }}",
							"rightValue": "",
							"operator": {
								"type": "boolean",
								"operation": "false",
								"singleValue": true
							}
						}
					],
					"combinator": "and"
				},
				"options": {}
			},
			"id": "8b0c3c1e-0000-4000-8000-000000000014",
			"name": "VAT Number Not Valid",
			"type": "n8n-nodes-base.if",
			"typeVersion": 2,
			"position": [
				720,
				0
			],
			"notes": "Only numbers VIES reports as not valid. Items with an 'error' field, or with 'valid' empty because VIES gave no answer, go to the other branch; re-check those later rather than treating them as invalid."
		},
		{
			"parameters": {},
			"id": "8b0c3c1e-0000-4000-8000-000000000015",
			"name": "Review Invalid VAT Numbers",
			"type": "n8n-nodes-base.noOp",
			"typeVersion": 1,
			"position": [
				960,
				-80
			],
			"notes": "Replace with an email, Slack or sheet update step."
		}
	],
	"connections": {
		"First of the Month": {
			"main": [
				[
					{
						"node": "Read Supplier List",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Read Supplier List": {
			"main": [
				[
					{
						"node": "Strale",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Strale": {
			"main": [
				[
					{
						"node": "VAT Number Not Valid",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"VAT Number Not Valid": {
			"main": [
				[
					{
						"node": "Review Invalid VAT Numbers",
						"type": "main",
						"index": 0
					}
				],
				[]
			]
		}
	},
	"settings": {}
}
