  "author": "Strale <hello@strale.io> (https://strale.dev?src=npm-readme&utm_source=npm-readme&utm_medium=listing&utm_campaign=distribution-d6)",
  "homepage": "https://github.com/strale-io/strale/tree/main/packages/ai-sdk-strale#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strale-io/strale.git",
    "directory": "packages/ai-sdk-strale"
  },
  "bugs": {
    "url": "https://github.com/strale-io/strale/issues"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
