---
// Home "tested against live sources" panel. Rows are the most recently tested tools
// from the public trust projection (/v1/public/ops/trust/capabilities/batch), as of
// the build. pass_rate there is the share of a tool's test suites whose latest run
// passed, so the row says "of its tests passed on their latest run", never "uptime".
// The list rolls slowly (ambient, DEC-20261025-A); hover or focus pauses it, and
// reduced motion shows it still.
import type { Tool } from "../lib/site-data";
import type { Trust } from "../lib/types";
import { formatDate, formatEur } from "../lib/format";

interface Props { tools: Tool[]; trust: Map<string, Trust>; loadedAt: string; limit?: number }
const { tools, trust, loadedAt, limit = 14 } = Astro.props;

const rows = tools
  .map((t) => ({ t, tr: trust.get(t.slug) }))
  .filter((r) => r.tr?.tested && r.tr.last_tested_at && r.tr.pass_rate !== null)
  .sort((a, b) => Date.parse(b.tr!.last_tested_at!) - Date.parse(a.tr!.last_tested_at!))
  .slice(0, limit);
---
{rows.length > 0 && (
  <div class="tested" data-tested>
    <div class="tested-head">
      <span class="tested-live"><span class="dot" aria-hidden="true"></span>Most recent tests</span>
      <span class="muted">as of {formatDate(loadedAt)}</span>
    </div>
    <div class="tested-window" tabindex="0" role="region" aria-label="Most recently tested tools">
      <ul class="tested-list" role="list">
        {[0, 1].map((copy) =>
          rows.map(({ t, tr }) => (
            <li class="tested-row" aria-hidden={copy === 1 ? "true" : undefined}>
              <span class="ok" aria-hidden="true"><svg class="icon icon-sm"><use href="#i-check" /></svg></span>
              <span class="who">
                <a class="link-quiet" href={`/tools/${t.slug}`} tabindex={copy === 1 ? -1 : undefined}>{t.name}</a>
                <span class="when">tested <time datetime={tr!.last_tested_at!} data-rel>{formatDate(tr!.last_tested_at!)}</time> · {tr!.pass_rate}% of its tests passed on their latest run</span>
              </span>
              <span class="num">{t.price_cents > 0 ? formatEur(t.price_cents) : "free"}</span>
            </li>
          )),
        )}
      </ul>
    </div>
  </div>
)}

<script>
  // Relative times ("12 min ago") from the ISO stamp; the absolute date stays as the fallback text.
  const units: [Intl.RelativeTimeFormatUnit, number][] = [["day", 86400], ["hour", 3600], ["minute", 60]];
  const rtf = new Intl.RelativeTimeFormat("en", { numeric: "auto" });
  for (const el of document.querySelectorAll<HTMLTimeElement>("time[data-rel]")) {
    const secs = (Date.parse(el.dateTime) - Date.now()) / 1000;
    if (!Number.isFinite(secs)) continue;
    const [unit, size] = units.find(([, s]) => Math.abs(secs) >= s) ?? ["minute", 60];
    el.textContent = rtf.format(Math.round(secs / size), unit);
  }
</script>

<style>
  .tested { background: var(--surface); border: var(--border-width) solid var(--border); border-radius: var(--radius-card); box-shadow: var(--shadow-2); overflow: hidden; }
  .tested-head { display: flex; justify-content: space-between; gap: var(--space-12); padding: var(--space-12) var(--space-16); border-bottom: var(--border-width) solid var(--border); font-size: var(--type-small-size); }
  .tested-live { display: inline-flex; align-items: center; gap: var(--space-8); font-family: var(--type-ui-family); font-weight: var(--type-ui-weight); }
  .dot { width: var(--space-8); height: var(--space-8); border-radius: var(--radius-pill); background: var(--success); box-shadow: 0 0 0 0 var(--success); animation: tested-ping var(--duration-reveal-atmosphere) var(--ease-standard) infinite; }
  @keyframes tested-ping { 0% { box-shadow: 0 0 0 0 var(--success-bg); } 70% { box-shadow: 0 0 0 var(--space-8) var(--success-bg); } 100% { box-shadow: 0 0 0 0 var(--success-bg); } }
  .tested-window { height: calc(var(--space-64) * 5); overflow: hidden; position: relative; mask-image: linear-gradient(to bottom, black 70%, transparent); }
  .tested-window:focus-visible { outline-offset: calc(-1 * var(--focus-width)); }
  .tested-list { margin: 0; padding: 0; animation: tested-roll var(--duration-ambient-slow) linear infinite; }
  .tested-window:hover .tested-list, .tested-window:focus-within .tested-list { animation-play-state: paused; }
  @keyframes tested-roll { from { transform: translateY(0); } to { transform: translateY(-50%); } }
  .tested-row { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: var(--space-12); align-items: start; padding: var(--space-12) var(--space-16); border-bottom: var(--border-width) solid var(--border); }
  .ok { display: inline-grid; place-items: center; width: var(--space-24); height: var(--space-24); border-radius: var(--radius-pill); background: var(--success-bg); color: var(--success); }
  .who { display: grid; gap: var(--space-2); min-width: 0; }
  .who a { font-family: var(--type-detail-family); font-weight: var(--type-detail-weight); font-size: var(--type-compact-size); }
  .when { color: var(--text-muted); font-size: var(--type-small-size); line-height: var(--type-small-line); }
  .tested-row .num { font-size: var(--type-small-size); color: var(--text-muted); white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) {
    .dot, .tested-list { animation: none; }
    .tested-window { overflow-y: auto; }
  }
</style>
