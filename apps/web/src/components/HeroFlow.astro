---
// Home hero artwork (Open Flow 0.2, Daylight): the kit's three bands converge on one
// agent, and real priced calls ride them in. Ambient loop allowed here by DEC-20261025-A;
// under prefers-reduced-motion the moving chips are replaced by still ones on the bands.
// Chip labels are tool slugs and their live list prices, passed in by the page.
import active from "@design/tokens/active.json";
import { formatEur } from "../lib/format";

interface Call { slug: string; price_cents: number }
interface Props { calls: Call[] }
const { calls } = Astro.props;

const cycleMs = active.surfaces.website.motion.duration.ambient;
// Band paths in the 560 × 440 drawing; each ends at the agent card's left edge.
const BANDS = [
  { id: "flow-a", d: "M0 56 C 140 46, 220 190, 376 204", stroke: "flow-grad-blue", width: 30 },
  { id: "flow-b", d: "M0 222 C 130 222, 250 220, 376 220", stroke: "flow-grad-violet", width: 26 },
  { id: "flow-c", d: "M0 388 C 150 396, 236 250, 376 236", stroke: "flow-grad-teal", width: 30 },
];
// Still positions (reduced motion): roughly a third of the way along each band.
const STILL = [{ x: 170, y: 104 }, { x: 190, y: 221 }, { x: 180, y: 338 }];
const CHAR_W = 7.4;
const chips = calls.slice(0, 6).map((c, i) => {
  const label = `${c.slug} · ${formatEur(c.price_cents)}`;
  const w = Math.round(label.length * CHAR_W + 28);
  const band = BANDS[i % BANDS.length];
  // Two chips per band, half a cycle apart; bands start a third of a cycle apart.
  const begin = -Math.round(((i % 3) / 3 + Math.floor(i / 3) / 2) * cycleMs);
  return { label, w, band, begin, still: i < 3 ? STILL[i] : null };
});
---
<svg class="hero-flow" viewBox="0 0 560 440" role="img" aria-labelledby="hero-flow-title">
  <title id="hero-flow-title">Tool calls, each with its price, flowing along three bands into one agent</title>
  <defs>
    <linearGradient id="flow-grad-blue" x1="0" x2="1"><stop offset="0" class="stop-blue" stop-opacity="0.08" /><stop offset="0.7" class="stop-blue" /></linearGradient>
    <linearGradient id="flow-grad-violet" x1="0" x2="1"><stop offset="0" class="stop-violet" stop-opacity="0.08" /><stop offset="0.7" class="stop-violet" /></linearGradient>
    <linearGradient id="flow-grad-teal" x1="0" x2="1"><stop offset="0" class="stop-teal" stop-opacity="0.08" /><stop offset="0.7" class="stop-teal" /></linearGradient>
  </defs>
  <g class="flow-bands" fill="none" stroke-linecap="round">
    {BANDS.map((b) => <path id={b.id} d={b.d} stroke={`url(#${b.stroke})`} stroke-width={b.width} pathLength="1" />)}
  </g>
  <g class="flow-agent">
    <rect class="agent-card" x="376" y="150" width="176" height="140" rx="20" />
    <circle class="agent-dot" cx="408" cy="186" r="13" />
    <circle class="agent-dot-core" cx="408" cy="186" r="5" />
    <text class="agent-name" x="430" y="183">Your agent</text>
    <text class="agent-sub" x="430" y="200">one connection</text>
    <rect class="agent-line" x="392" y="226" width="140" height="9" rx="4.5" />
    <rect class="agent-line" x="392" y="244" width="104" height="9" rx="4.5" />
    <rect class="agent-line" x="392" y="262" width="122" height="9" rx="4.5" />
  </g>
  <g class="flow-chips flow-moving">
    {chips.map((c) => (
      <g class="chip" opacity="0">
        <rect x={-c.w / 2} y="-14" width={c.w} height="28" rx="14" />
        <text x="0" y="4" text-anchor="middle">{c.label}</text>
        <animateMotion dur={`${cycleMs}ms`} begin={`${c.begin}ms`} repeatCount="indefinite" calcMode="spline" keyTimes="0;1" keySplines="0.4 0 0.6 1">
          <mpath href={`#${c.band.id}`} />
        </animateMotion>
        <animate attributeName="opacity" dur={`${cycleMs}ms`} begin={`${c.begin}ms`} repeatCount="indefinite" values="0;1;1;0;0" keyTimes="0;0.1;0.74;0.84;1" />
      </g>
    ))}
  </g>
  <g class="flow-chips flow-still">
    {chips.filter((c) => c.still).map((c) => (
      <g class="chip" transform={`translate(${c.still!.x} ${c.still!.y})`}>
        <rect x={-c.w / 2} y="-14" width={c.w} height="28" rx="14" />
        <text x="0" y="4" text-anchor="middle">{c.label}</text>
      </g>
    ))}
  </g>
</svg>

<style>
  .hero-flow { width: 100%; height: auto; display: block; overflow: hidden; }
  .stop-blue { stop-color: var(--brand-blue); }
  .stop-violet { stop-color: var(--brand-violet); }
  .stop-teal { stop-color: var(--brand-teal); }
  .flow-bands path { stroke-dasharray: 1; stroke-dashoffset: 0; animation: flow-draw var(--duration-reveal-signature) var(--ease-reveal) both; }
  .flow-bands path:nth-child(2) { animation-delay: var(--duration-base); }
  .flow-bands path:nth-child(3) { animation-delay: var(--duration-slow); }
  @keyframes flow-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  .agent-card { fill: var(--surface); stroke: var(--border-strong); }
  .agent-dot { fill: var(--brand-blue); }
  .agent-dot-core { fill: var(--brand-paper); }
  .agent-name { fill: var(--text); font-family: var(--type-detail-family); font-weight: var(--type-detail-weight); font-size: var(--type-small-size); }
  .agent-sub { fill: var(--text-muted); font-family: var(--type-code-family); font-size: var(--type-label-size); }
  .agent-line { fill: var(--surface-sunken); }
  .chip rect { fill: var(--surface); stroke: var(--border); }
  .chip text { fill: var(--text); font-family: var(--type-code-family); font-size: var(--type-label-size); }
  .flow-still { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .flow-moving { display: none; }
    .flow-still { display: inline; }
    .flow-bands path { animation: none; }
  }
</style>
