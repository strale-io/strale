---
// Header: Tools · Company data · Use cases · Pricing · Docs, then one button (SITE-STRUCTURE.md).
// No login link: there is no login product (claims.yaml sign-in-no-login-product).
interface Props { current?: string }
const { current } = Astro.props;
const items = [
  { id: "tools", href: "/tools", label: "Tools" },
  { id: "company-data", href: "/company-data", label: "Company data" },
  { id: "use-cases", href: "/use-cases", label: "Use cases" },
  { id: "pricing", href: "/pricing", label: "Pricing" },
  { id: "docs", href: "/docs", label: "Docs" },
];
const themes = [
  { id: "system", icon: "i-monitor", label: "Follow system theme" },
  { id: "light", icon: "i-sun", label: "Light theme" },
  { id: "dark", icon: "i-moon", label: "Dark theme" },
];
---
<header class="site-nav">
  <div class="container site-nav-bar">
    <a class="brand" href="/" aria-label="Strale home">
      <img class="logo-ink" src="/brand/lockup-ink.svg" alt="" width="82" height="24" />
      <img class="logo-inverse" src="/brand/lockup-inverse.svg" alt="" width="82" height="24" />
    </a>
    <nav aria-label="Main">
      <ul class="nav-links">
        {items.map((i) => <li><a class="nav-link" href={i.href} aria-current={current === i.id ? "page" : undefined}>{i.label}</a></li>)}
      </ul>
    </nav>
    <div class="nav-actions">
      <div class="theme-switch" role="group" aria-label="Colour theme">
        {themes.map((t) => <button type="button" data-theme-choice={t.id} aria-pressed={t.id === "system" ? "true" : "false"} title={t.label}><svg class="icon icon-sm" aria-hidden="true"><use href={`#${t.icon}`} /></svg><span class="visually-hidden">{t.label}</span></button>)}
      </div>
      <a class="btn btn-primary" href="/signup">Get an API key</a>
    </div>
    <button class="nav-link menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu" data-disclosure><span data-label>Menu</span> <svg class="icon" aria-hidden="true"><use href="#i-menu" /></svg></button>
  </div>
  <div class="mobile-menu container" id="mobile-menu" hidden>
    <nav aria-label="Main, mobile">
      <ul>
        {items.map((i) => <li><a class="nav-link" href={i.href} aria-current={current === i.id ? "page" : undefined}>{i.label} <svg class="icon icon-sm" aria-hidden="true"><use href="#i-arrow" /></svg></a></li>)}
      </ul>
    </nav>
    <div class="mobile-actions">
      <div class="theme-switch" role="group" aria-label="Colour theme">
        {themes.map((t) => <button type="button" data-theme-choice={t.id} aria-pressed={t.id === "system" ? "true" : "false"}><svg class="icon icon-sm" aria-hidden="true"><use href={`#${t.icon}`} /></svg><span class="visually-hidden">{t.label}</span></button>)}
      </div>
      <a class="btn btn-primary" href="/signup">Get an API key</a>
    </div>
  </div>
</header>
