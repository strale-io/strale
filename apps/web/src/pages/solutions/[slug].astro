---
// Bundled check detail (SITE-STRUCTURE.md page 4): a tool page plus the steps it
// runs and what the bundle adds. URLs are unchanged from today's site. A summary
// written by risk-narrative-generate is AI-generated and is labelled so, for a
// person to review (DEC-20260428-B); never "decides", "approves" or "compliant".
import Base from "../../layouts/Base.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import { getSiteData, toolBySlug } from "../../lib/site-data.ts";
import { formatEur, formatUsd, plural } from "../../lib/format.ts";
import { solutionSnippets } from "../../lib/snippets.ts";
import { TRANSPARENCY } from "../../lib/describe.ts";

export async function getStaticPaths() {
  const data = await getSiteData();
  return data.solutions.map((s) => ({ params: { slug: s.slug }, props: { slug: s.slug } }));
}

const { slug } = Astro.props as { slug: string };
const data = await getSiteData();
const solution = data.solutions.find((s) => s.slug === slug)!;
const bySlug = toolBySlug(data);
const steps = solution.capabilities.map((s) => bySlug.get(s) ?? { slug: s, name: s, description: "", data_source: null, transparency_tag: null });
const hasSummary = solution.capabilities.includes("risk-narrative-generate");
const x402 = data.x402.solutions.find((x) => x.slug === slug) ?? null;
// The bundle's inputs are the union of its steps' required inputs, with each step's example value.
const inputs: Record<string, unknown> = {};
for (const s of solution.capabilities) {
  const ex = data.manifests.get(s)?.example_input ?? {};
  for (const k of bySlug.get(s)?.input_schema?.required ?? []) if (!(k in inputs) && k in ex) inputs[k] = ex[k];
}
const limitations = data.solutionLimitations.get(slug) ?? [];
const transparency = solution.transparency_tag ? TRANSPARENCY[solution.transparency_tag] : undefined;
---
<Base title={solution.name} current="tools" description={solution.description.slice(0, 160)}>
  <article>
    <header class="tool-head">
      <div class="container stack">
        <nav aria-label="Breadcrumb" class="small"><a class="link" href="/tools#bundled">Bundled checks</a></nav>
        <h1 class="t-campaign">{solution.name}</h1>
        <p class="t-lead">{solution.description}</p>
        <div class="row">
          <span class="tag">{plural(steps.length, "step")}</span>
          {x402 && <span class="tag tag-kit">x402 eligible</span>}
          {hasSummary && <span class="tag tag-soft">Includes an AI-written summary</span>}
          <code class="slug">{slug}</code>
        </div>
      </div>
    </header>

    <div class="container tool-layout">
      <div class="tool-main">
        <section aria-labelledby="steps-title" class="stack">
          <h2 id="steps-title" class="t-section">What it runs</h2>
          <ol class="steps" role="list">
            {steps.map((s, i) => (
              <li class="step">
                <span class="step-n num" aria-hidden="true">{i + 1}</span>
                <div class="stack-tight">
                  <a class="link-quiet step-name" href={`/tools/${s.slug}`}>{s.name}</a>
                  {s.data_source && <p class="small muted">Source: {s.data_source}</p>}
                  {s.slug === "risk-narrative-generate" && <p class="small">Written by an AI model from the other steps’ results, for a person to review. It does not make the decision.</p>}
                </div>
              </li>
            ))}
          </ol>
          <p class="t-compact muted">The answer returns every step’s result, so your agent can show or check each one.</p>
        </section>

        <section aria-labelledby="call-title" class="stack">
          <h2 id="call-title" class="t-section">How to call it</h2>
          <CodeBlock id="calls" title="How to call it" panels={solutionSnippets({ slug, inputs, priceCents: solution.price_cents, x402 })} />
          <p class="small muted">Example inputs taken from the steps’ published test inputs.</p>
        </section>

        <section aria-labelledby="limits-title" class="stack">
          <h2 id="limits-title" class="t-section">Limitations</h2>
          {limitations.length ? (
            <ul class="limits" role="list">
              {limitations.map((l) => (
                <li class="limit">
                  <p class="limit-title">{l.text}</p>
                  {l.step && <p class="small muted">From step: {bySlug.get(l.step)?.name ?? l.step}</p>}
                  {l.workaround && <p class="t-compact"><span class="muted">What to do instead: </span>{l.workaround}</p>}
                </li>
              ))}
            </ul>
          ) : <p class="muted">No limitations are recorded for this check’s steps.</p>}
        </section>
      </div>

      <aside class="tool-side stack-loose" aria-label="Price and method">
        <section class="card stack-tight" aria-labelledby="price-title">
          <h2 id="price-title" class="label">Price per check</h2>
          <p class="t-stat">{formatEur(solution.price_cents)}</p>
          <p class="t-compact muted">One price for every step. Refunded only if every step fails; a check where some steps fail is charged in full.</p>
          {x402 && <p class="t-compact">Over x402: <span class="num">{formatUsd(x402.price_usd)}</span> USDC per request, no account.</p>}
          <a class="btn btn-primary" href="#call-title">Copy the call</a>
        </section>
        {transparency && (
          <section class="card stack-tight" aria-labelledby="method-title">
            <h2 id="method-title" class="label">Method</h2>
            <p class="t-compact muted">{transparency}</p>
          </section>
        )}
      </aside>
    </div>
  </article>
</Base>

<style>
  .tool-head { padding-block: var(--space-48) var(--space-32); border-bottom: var(--border-width) solid var(--border); }
  .tool-head .t-lead { max-width: var(--measure-body); }
  .slug { font-size: var(--type-small-size); }
  .tool-layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-48); padding-block: var(--space-48) var(--space-64); }
  .tool-main { display: grid; gap: var(--space-64); min-width: 0; }
  @media (min-width: 1024px) { .tool-layout { grid-template-columns: minmax(0, 8fr) minmax(0, 3fr); } .tool-side { position: sticky; top: calc(var(--nav-h) + var(--space-24)); align-self: start; } }
  .steps { display: grid; gap: var(--space-12); margin: 0; padding: 0; list-style: none; }
  .step { display: grid; grid-template-columns: var(--space-32) minmax(0, 1fr); gap: var(--space-12); align-items: start; padding: var(--space-16); background: var(--surface); border: var(--border-width) solid var(--border); border-radius: var(--radius-card); }
  .step-n { display: inline-grid; place-items: center; width: var(--space-32); height: var(--space-32); border-radius: var(--radius-pill); background: var(--surface-blue); color: var(--text); }
  .step-name { font-weight: var(--type-detail-weight); }
  .limits { display: grid; gap: var(--space-16); margin: 0; padding: 0; }
  .limit { display: grid; gap: var(--space-4); padding-left: var(--space-16); border-left: var(--focus-width) solid var(--border-strong); }
  .limit-title { font-weight: var(--type-detail-weight); }
  .tool-side .card { box-shadow: none; }
</style>
