---
// Tool detail (SITE-STRUCTURE.md page 3): everything needed to make the first call.
// Sections: job, example, inputs, output fields, price, how to call, limitations,
// source and method, last test, related. Never a quality score; a test date only
// with the test it came from (claims.yaml sqs-quality-score-trust-layer,
// every-tool-continuously-tested).
import Base from "../../layouts/Base.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import InputsTable from "../../components/tool/InputsTable.astro";
import OutputsTable from "../../components/tool/OutputsTable.astro";
import Limitations from "../../components/tool/Limitations.astro";
import { getSiteData, tools as allTools, solutionsFor, API_BASE, type Tool } from "../../lib/site-data.ts";
import { formatEur, formatUsd, formatDate, json, plural } from "../../lib/format.ts";
import { FREE_TIER_DAILY_LIMIT } from "../../lib/code-facts.ts";
import { toolSnippets } from "../../lib/snippets.ts";
import { TRANSPARENCY } from "../../lib/describe.ts";
import { JOB_GROUPS } from "../../content/jobs.ts";

export async function getStaticPaths() {
  const data = await getSiteData();
  return allTools(data).map((tool) => ({ params: { slug: tool.slug }, props: { slug: tool.slug } }));
}

const { slug } = Astro.props as { slug: string };
const data = await getSiteData();
const tools = allTools(data);
const tool = tools.find((t) => t.slug === slug) as Tool;
const extras = data.manifests.get(slug);
const job = JOB_GROUPS.find((g) => g.id === tool.job)!;
const inputs = extras?.example_input ?? {};
const output = tool.output_schema?.example ?? null;
const reliability = extras?.output_field_reliability ?? {};
const limitations = data.limitations.get(slug) ?? [];
const trust = data.trust.get(slug);
const bundles = solutionsFor(data, slug);
const related = tools.filter((t) => t.job === tool.job && t.slug !== slug && (t.category === tool.category || t.country !== null && tool.country !== null)).slice(0, 6);
const snippets = toolSnippets({ slug, inputs, priceCents: tool.price_cents, free: tool.free, x402: tool.x402 });
const transparency = tool.transparency_tag ? TRANSPARENCY[tool.transparency_tag] : undefined;
// The published example input and example answer are recorded separately. Show them side by side
// only when the answer visibly belongs to the input (every input value appears in it); otherwise
// show the answer on its own, and the call below carries the input.
const flat = (v: unknown) => String(v).toLowerCase().replace(/[^a-z0-9]/g, "");
const outText = output ? flat(JSON.stringify(output)) : "";
const inputValues = Object.values(inputs).filter((v) => typeof v === "string" || typeof v === "number");
const paired = !!output && inputValues.length > 0 && inputValues.every((v) => outText.includes(flat(v)));
---
<Base title={tool.name} current="tools" description={tool.description.slice(0, 160)}>
  <article>
    <header class="tool-head">
      <div class="container stack">
        <nav aria-label="Breadcrumb" class="small"><a class="link" href="/tools">Tools</a> <span aria-hidden="true">/</span> <a class="link" href={`/tools?job=${job.id}`}>{job.label}</a></nav>
        <h1 class="t-campaign">{tool.name}</h1>
        <p class="t-lead">{tool.description}</p>
        <div class="row">
          {tool.free && <span class="tag tag-teal">Free to try</span>}
          {tool.x402 && <span class="tag tag-kit">Pay by wallet (x402)</span>}
          {tool.transparency_tag === "ai_generated" && <span class="tag tag-soft">AI-generated</span>}
          {tool.country && <a class="tag tag-link" href={`/company-data/${tool.country.path}`}>{tool.country.name}: all company records</a>}
          <code class="slug">{tool.slug}</code>
        </div>
      </div>
    </header>

    <div class="container tool-layout">
      <div class="tool-main">
        <section aria-labelledby="example-title" class="stack">
          <h2 id="example-title" class="t-section">Example</h2>
          {paired ? (
            <div class="grid-2 example-grid">
              <CodeBlock id="ex-in" title="Input" wrap panels={[{ label: "Input", lang: "json", code: json(inputs) }]} />
              <CodeBlock id="ex-out" title="Answer" wrap panels={[{ label: "Answer", lang: "json", code: json(output) }]} />
            </div>
          ) : output ? (
            <CodeBlock id="ex-out" title="Example answer" wrap panels={[{ label: "Answer", lang: "json", code: json(output) }]} />
          ) : (
            <>
              <CodeBlock id="ex-in" title="Example input" wrap panels={[{ label: "Input", lang: "json", code: json(inputs) }]} />
              <p class="small muted">The fields it answers with are listed under Output fields.</p>
            </>
          )}
          {tool.free && (
            <form class="try card" data-try data-api={API_BASE} data-slug={slug}>
              <h3 class="t-subhead">Try it</h3>
              <p class="t-compact muted">Runs the real tool from your browser, with no key. Free calls are limited to {FREE_TIER_DAILY_LIMIT} a day across all free tools.</p>
              <div class="field">
                <label class="field-label" for="try-inputs">Inputs (JSON)</label>
                <textarea class="textarea code-input" id="try-inputs" name="inputs" spellcheck="false" aria-describedby="try-help">{json(inputs)}</textarea>
                <p class="field-help" id="try-help">Edit the values, then run.</p>
              </div>
              <div class="row"><button class="btn btn-primary" type="submit">Run {tool.name}</button></div>
              <div role="status" aria-live="polite" data-try-status class="small"></div>
              <pre class="try-output" data-try-output hidden tabindex="0"></pre>
            </form>
          )}
        </section>

        <section aria-labelledby="inputs-title" class="stack">
          <h2 id="inputs-title" class="t-section">Inputs</h2>
          <InputsTable schema={tool.input_schema} />
        </section>

        <section aria-labelledby="outputs-title" class="stack">
          <h2 id="outputs-title" class="t-section">Output fields</h2>
          <p class="t-compact muted">How reliably each field appears in a successful answer.</p>
          <OutputsTable schema={tool.output_schema} reliability={reliability} />
        </section>

        <section aria-labelledby="call-title" class="stack">
          <h2 id="call-title" class="t-section">How to call it</h2>
          <p class="t-compact muted">The same tool through each route. MCP clients reach it through Strale’s server at <code>{API_BASE}/mcp</code>; the call below is what the agent sends.</p>
          <CodeBlock id="calls" title="How to call it" panels={snippets} />
        </section>

        <section aria-labelledby="limits-title" class="stack">
          <h2 id="limits-title" class="t-section">Limitations</h2>
          <Limitations items={limitations} empty="No limitations are recorded for this tool." />
        </section>
      </div>

      <aside class="tool-side stack-loose" aria-label="Price, source and tests">
        <section class="card stack-tight" aria-labelledby="price-title">
          <h2 id="price-title" class="label">Price per call</h2>
          {tool.free ? (
            <>
              <p class="t-stat">Free</p>
              <p class="t-compact muted">Without a key: up to {FREE_TIER_DAILY_LIMIT} calls a day across all free tools. With an API key, normal rate limits apply and nothing is charged.</p>
              {tool.x402 && tool.x402.price_usd > 0 && <p class="t-compact">Over x402 it is a paid call: <span class="num">{formatUsd(tool.x402.price_usd)}</span> USDC per request.</p>}
            </>
          ) : (
            <>
              <p class="t-stat">{formatEur(tool.price_cents)}</p>
              <p class="t-compact muted">Charged only when the call succeeds.</p>
            </>
          )}
          {tool.x402 && !tool.free && <p class="t-compact">Over x402: <span class="num">{formatUsd(tool.x402.price_usd)}</span> USDC per request, no account.</p>}
          <a class="btn btn-primary" href="#call-title">Copy the call</a>
        </section>
        <section class="card stack-tight" aria-labelledby="source-title">
          <h2 id="source-title" class="label">Source and method</h2>
          <p class="t-compact">{tool.data_source ?? "Not stated"}</p>
          {transparency && <p class="t-compact muted">{transparency}</p>}
        </section>
        <section class="card stack-tight" aria-labelledby="test-title">
          <h2 id="test-title" class="label">Last recorded test</h2>
          {trust?.tested && trust.last_tested_at ? (
            <p class="t-compact">{formatDate(trust.last_tested_at)}{trust.pass_rate !== null && <span class="muted"> · {trust.pass_rate === 100 ? "all tests passed" : `${trust.pass_rate}% of tests passed`}</span>}</p>
          ) : (
            <p class="t-compact muted">No test result is recorded for this tool{data.mode !== "live" ? " in this preview build" : ""}.</p>
          )}
        </section>
      </aside>
    </div>

    {(bundles.length > 0 || related.length > 0) && (
      <section class="section section-sunken" aria-label="Related">
        <div class="container grid-2">
          {bundles.length > 0 && (
            <div class="stack">
              <h2 class="t-subhead">Bundled checks that include it</h2>
              <ul class="plain-list stack-tight">{bundles.map((b) => <li><a class="link" href={`/solutions/${b.slug}`}>{b.name}</a> <span class="muted num">{formatEur(b.price_cents)}</span></li>)}</ul>
            </div>
          )}
          {related.length > 0 && (
            <div class="stack">
              <h2 class="t-subhead">Related tools</h2>
              <ul class="plain-list stack-tight">{related.map((r) => <li><a class="link" href={`/tools/${r.slug}`}>{r.name}</a> <span class="muted num">{r.free ? "Free" : formatEur(r.price_cents)}</span></li>)}</ul>
            </div>
          )}
        </div>
      </section>
    )}
  </article>
</Base>

<script>import "../../scripts/try-it.ts";</script>

<style>
  .tool-head { padding-block: var(--space-48) var(--space-32); border-bottom: var(--border-width) solid var(--border); }
  .tool-head .t-lead { max-width: var(--measure-body); }
  .slug { font-size: var(--type-small-size); }
  .tool-layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-48); padding-block: var(--space-48) var(--space-64); }
  .tool-main { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--stack-heading-before); min-width: 0; }
  @media (min-width: 1024px) { .tool-layout { grid-template-columns: minmax(0, 8fr) minmax(0, 3fr); } .tool-side { position: sticky; top: calc(var(--nav-h) + var(--space-24)); align-self: start; } }
  .example-grid { align-items: start; }
  .code-input { font-family: var(--type-code-family); font-size: var(--type-ui-size); min-height: calc(var(--space-128) + var(--space-32)); }
  .try-output { margin: 0; padding: var(--space-16); background: var(--code-bg); color: var(--code-text); border-radius: var(--radius-card); overflow-x: auto; max-height: calc(var(--space-160) * 3); }
  .tool-side .card { box-shadow: none; }
  .tag-link { text-decoration: none; }
  .tag-link:hover { color: var(--link); text-decoration: underline; }
  .section { padding-block: var(--space-64); }
  .section-sunken { background: var(--surface-sunken); }
</style>
