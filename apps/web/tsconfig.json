{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "public"
  ],
  "compilerOptions": {
    "paths": {
      "@design/*": [
        "../../design/*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
