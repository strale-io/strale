{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "status",
    "production_adopted",
    "source",
    "token_source",
    "assets",
    "gradients",
    "identity",
    "illustrations",
    "fonts",
    "resolutions",
    "missing_sources",
    "rules",
    "claim_source",
    "specimen_copy",
    "authority",
    "specimens",
    "font_sources",
    "composition_revision"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "const": "candidate"
    },
    "production_adopted": {
      "const": false
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "gradients": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "token",
          "css",
          "role",
          "status",
          "composition",
          "surface_token",
          "ink_token",
          "secondary_token",
          "pair_status"
        ],
        "properties": {
          "composition": {
            "enum": [
              "frame",
              "direct"
            ]
          },
          "surface_token": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "identity": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "illustrations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "fonts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "sha256",
          "role",
          "family"
        ],
        "properties": {
          "sha256": {
            "$ref": "#/$defs/hash"
          }
        }
      }
    },
    "resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status",
          "choice",
          "remaining"
        ]
      }
    },
    "missing_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "status",
          "required_for_build"
        ],
        "properties": {
          "status": {
            "const": "unavailable"
          },
          "required_for_build": {
            "const": false
          }
        }
      }
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "specimens": {
      "type": "object",
      "required": [
        "rows_by_shape",
        "compact_rule"
      ],
      "properties": {
        "rows_by_shape": {
          "const": {
            "wide": 2,
            "square": 1,
            "phone": 1
          }
        },
        "compact_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "font_sources": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "family",
          "url",
          "licence",
          "files"
        ],
        "properties": {
          "family": {
            "enum": [
              "Instrument Sans",
              "IBM Plex Mono"
            ]
          },
          "licence": {
            "const": "SIL OFL 1.1"
          },
          "files": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "composition_revision": {
      "type": "object",
      "required": [
        "version",
        "basis",
        "predecessor_commit",
        "production_adopted",
        "gradient_frame_inset_token",
        "gradient_frame_inner_radius_token",
        "atmosphere_alignment",
        "light_gradient_direct_text",
        "reading_surface_token"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "0.2"
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "predecessor_commit": {
          "const": "2972015dedfeb8bcd30369e0b0b4259bdc62f678"
        },
        "production_adopted": {
          "const": false
        },
        "gradient_frame_inset_token": {
          "const": "--c-frame-inset"
        },
        "gradient_frame_inner_radius_token": {
          "const": "--c-frame-inner-radius"
        },
        "atmosphere_alignment": {
          "const": "bottom"
        },
        "light_gradient_direct_text": {
          "const": [
            "frost",
            "mint"
          ]
        },
        "reading_surface_token": {
          "const": "--surface"
        }
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file": {
      "type": "object",
      "required": [
        "id",
        "source_path",
        "sha256"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "asset": {
      "allOf": [
        {
          "$ref": "#/$defs/file"
        },
        {
          "type": "object",
          "required": [
            "title",
            "token",
            "width",
            "height",
            "bytes",
            "status",
            "source_status",
            "role",
            "guidance",
            "recipe_status",
            "surface_token",
            "ink_token",
            "secondary_token",
            "crop",
            "provenance",
            "verification"
          ],
          "properties": {
            "status": {
              "const": "candidate"
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "surface_token": {
              "type": [
                "string",
                "null"
              ]
            },
            "ink_token": {
              "type": [
                "string",
                "null"
              ]
            },
            "crop": {
              "type": "object",
              "required": [
                "fit",
                "position",
                "basis",
                "desktop",
                "narrow",
                "square"
              ]
            },
            "provenance": {
              "type": "object",
              "required": [
                "file_confidence",
                "creation_history",
                "rights",
                "parent_id",
                "lineage"
              ]
            },
            "verification": {
              "type": "object",
              "required": [
                "asset_integrity",
                "crop_review",
                "contextual_contrast",
                "accessibility"
              ]
            }
          }
        }
      ]
    }
  }
}
