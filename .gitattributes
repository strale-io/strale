# Auto detect text files and perform LF normalization
* text=auto

# Force LF for the auto-generated coverage-matrix summary so the
# regen --check round-trip stays clean on Windows. See
# apps/api/scripts/regenerate-coverage-matrix-summary.mjs.
apps/api/coverage-matrix/COVERAGE.md text eol=lf
apps/api/src/jobs/*.ts text eol=lf
apps/api/src/jobs/__fixtures__/*.sql text eol=lf
docs/project/** text eol=lf
docs/decisions/README.md text eol=lf
docs/decisions/PENDING.md text eol=lf
docs/governance/** text eol=lf
scripts/project-context-lib.mjs text eol=lf
scripts/generate-project-context.mjs text eol=lf
scripts/check-project-context.mjs text eol=lf
scripts/check-project-context.test.mjs text eol=lf
docs/programs/** text eol=lf
scripts/program-tracks-lib.mjs text eol=lf
scripts/check-program-tracks.mjs text eol=lf
scripts/program-tracks.test.mjs text eol=lf
scripts/m2-closure-register-lib.mjs text eol=lf
scripts/m2-closure-register.test.mjs text eol=lf
scripts/m2-closure-verify-private-rows.mjs text eol=lf
