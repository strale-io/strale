{
  "name": "strale",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/api",
    "build": "npm run build --workspace=apps/api",
    "db:generate": "npm run db:generate --workspace=apps/api",
    "db:migrate": "npm run db:migrate --workspace=apps/api",
    "db:push": "npm run db:push --workspace=apps/api",
    "mcp:build": "npm run build --workspace=packages/mcp-server",
    "mcp:dev": "npm run dev --workspace=packages/mcp-server",
    "test": "npm run test --workspace=apps/api",
    "typecheck": "npm run typecheck --workspace=apps/api && npm run typecheck:scripts --workspace=apps/api && npm run typecheck --workspace=packages/sdk-typescript && npm run typecheck --workspace=packages/langchain && npm run typecheck --workspace=packages/semantic-kernel-strale && npm run typecheck --workspace=packages/mcp-server",
    "validate:coverage-matrix": "node apps/api/scripts/validate-coverage-matrix.mjs",
    "coverage-matrix:summary": "node apps/api/scripts/regenerate-coverage-matrix-summary.mjs",
    "coverage-matrix:check": "npm run validate:coverage-matrix && npm run coverage-matrix:summary -- --check",
    "context:generate": "node scripts/generate-project-context.mjs",
    "context:check": "node scripts/check-project-context.mjs",
    "context:test": "node --test scripts/check-project-context.test.mjs scripts/decision-records.test.mjs scripts/m2-closure-register.test.mjs",
    "programs:check": "node scripts/check-program-tracks.mjs",
    "programs:test": "node --test scripts/program-tracks.test.mjs",
    "research:check": "node scripts/check-research.mjs",
    "research:test": "node --test scripts/research.test.mjs",
    "research:index": "node scripts/generate-research-index.mjs",
    "design:check": "node scripts/check-design.mjs",
    "design:test": "node --test scripts/design.test.mjs",
    "design:tokens:generate": "node scripts/generate-design-tokens.mjs",
    "env:check": "node scripts/check-env.mjs",
    "env:test": "node --test scripts/env.test.mjs",
    "env:example": "node scripts/generate-env-example.mjs",
    "models:check": "node apps/api/scripts/check-model-literals.mjs",
    "models:test": "node --test apps/api/scripts/check-model-literals.test.mjs",
    "claims:check": "node scripts/check-claims.mjs",
    "claims:test": "node --test scripts/claims.test.mjs",
    "handoff:check": "node scripts/handoff/handoff-check.mjs",
    "handoff:test": "node --test scripts/handoff/handoff-check.test.mjs",
    "handoff:orient": "node scripts/handoff/orient.mjs",
    "handoff:baseline": "node scripts/handoff/handoff-check.mjs baseline",
    "hooks:install": "node scripts/handoff/install-hooks.mjs",
    "prepare": "node scripts/handoff/install-hooks.mjs || exit 0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "bech32": "^2.0.0",
    "bs58check": "^4.0.0",
    "esbuild": "^0.27.4",
    "ripple-address-codec": "^5.0.0"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "commonmark": "^0.31.2",
    "yaml": "^2.8.1"
  }
}
